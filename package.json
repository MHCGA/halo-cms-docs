{
  "name": "halo-cms-docs",
  "version": "1.0.0",
  "private": true,
  "description": "Share tips related to Halo CMS.",
  "keywords": [
    "halo"
  ],
  "homepage": "https://github.com/MHCGA",
  "license": "MIT",
  "author": "MHCGA",
  "repository": {
    "type": "git",
    "url": "https://github.com/MHCGA/halo-cms-docs"
  },
  "type": "module",
  "scripts": {
    "build": "pnpm run '/:build$/'",
    "docs:build": "vitepress build docs",
    "docs:preview": "pnpm run docs:build && vitepress preview docs",
    "docs:watch": "vitepress dev docs",
    "fmt": "pnpm run '/^fmt:/'",
    "fmt:oxfmt": "oxfmt --threads 2 '**/*.{json,jsonc,yaml,md,css,js,ts,vue,html}' '.github/**/*.{yml,js,json}'",
    "lint": "pnpm run '/^lint:/'",
    "lint:autocorrect": "autocorrect --fix",
    "lint:md": "markdownlint --fix '**/*.md' --ignore-path .gitignore",
    "lint:oxlint+eslint": "oxlint --type-aware --report-unused-disable-directives --fix && eslint --fix",
    "lint:style": "stylelint --fix '**/*.{css,vue}' 'docs/.vitepress/**/*.{css,vue}' --ignore-path .gitignore",
    "lint:type-check": "vue-tsc -b",
    "migrate:oxlint": "pnpm dlx @oxlint/migrate --type-aware --with-nursery && pnpm run fmt",
    "preinstall": "npx only-allow pnpm",
    "watch": "pnpm run '/:watch$/'"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@eslint/js": "^10.0.1",
    "@giscus/vue": "^3.1.1",
    "@nolebase/vitepress-plugin-highlight-targeted-heading": "^2.21.1",
    "@types/node": "^26.6.5",
    "@typescript-eslint/parser": "^8.72.1",
    "autocorrect-node": "^2.14.0",
    "browserslist": "^4.29.5",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-oxlint": "^1.89.0",
    "eslint-plugin-vue": "^10.12.0",
    "globals": "^17.13.0",
    "lightningcss": "^1.33.0",
    "markdownlint-cli": "^0.50.0",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2005",
    "pagefind": "^1.5.2",
    "stylelint": "^17.16.0",
    "stylelint-config-html": "^2.0.0",
    "stylelint-config-recommended-vue": "^2.0.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-order": "^8.1.2",
    "typescript-eslint": "^8.72.1",
    "vitepress": "2.0.0-alpha.21",
    "vitepress-plugin-pagefind": "^0.4.25",
    "vitepress-plugin-rss": "^0.4.5",
    "vue": "^3.5.44",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.13"
  },
  "browserslist": [
    "defaults",
    "Safari >= 16.4",
    "Chrome >= 111",
    "Firefox >= 128"
  ],
  "engines": {
    "node": ">=24",
    "pnpm": "^12.16.1"
  },
  "packageManager": "pnpm@12.16.1"
}
